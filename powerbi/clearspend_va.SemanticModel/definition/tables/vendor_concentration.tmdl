table vendor_concentration
	lineageTag: cf59bf19-b5a0-4a21-ab80-b7be45d3bb92

	measure Vendors = IF ( MAX ( vendor_concentration[vendor_count] ) >= 10, MAX ( vendor_concentration[vendor_count] ) )
		formatString: #,0
		lineageTag: d5b9ddd6-0535-49b6-b4f7-e53f33dfb924

	measure 'Paid to Vendors' = IF ( [Vendors] > 0, SUM ( vendor_concentration[vendor_spend] ) )
		formatString: \$#,0
		lineageTag: 381aa70c-dd2e-4c83-9428-798ee9b3204d

	measure 'Top Vendor Share' = IF ( [Vendors] > 0, MAX ( vendor_concentration[top_vendor_share] ) )
		formatString: 0%
		lineageTag: 141dc5dc-d310-4f9f-86b4-533cde517f47

	measure 'HHI Score' = IF ( [Vendors] > 0, MAX ( vendor_concentration[hhi] ) )
		formatString: #,0
		lineageTag: 34f70d34-98d5-4e37-9349-d0fa442944a0

	column agency
		dataType: string
		lineageTag: 56e68273-cdcb-43b7-92b0-452914876abd
		summarizeBy: none
		sourceColumn: agency

		annotation SummarizationSetBy = Automatic

	column secretariat
		dataType: string
		lineageTag: 630ba52f-3489-47a4-a99b-fe236c75f18f
		summarizeBy: none
		sourceColumn: secretariat

		annotation SummarizationSetBy = Automatic

	column fiscal_year
		dataType: int64
		formatString: 0
		lineageTag: 24f82671-ee36-4aa9-8753-49589330e581
		summarizeBy: sum
		sourceColumn: fiscal_year

		annotation SummarizationSetBy = Automatic

	column vendor_count
		dataType: int64
		formatString: 0
		lineageTag: c6338e8d-6b27-466f-87b1-aa422099cc7b
		summarizeBy: sum
		sourceColumn: vendor_count

		annotation SummarizationSetBy = Automatic

	column vendor_spend
		dataType: double
		lineageTag: 09bd6eef-1362-4810-84bf-22bd43f8e302
		summarizeBy: sum
		sourceColumn: vendor_spend

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column top_vendor_share
		dataType: double
		lineageTag: 2581d717-0b35-4b2e-87aa-f98d13d78aaa
		summarizeBy: sum
		sourceColumn: top_vendor_share

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column hhi
		dataType: double
		lineageTag: ae00823b-da64-46dd-b9de-d2e8f0ae1288
		summarizeBy: sum
		sourceColumn: hhi

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition vendor_concentration = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\v_vendor_concentration.csv"), [Delimiter=",", Columns=7, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"agency", type text}, {"secretariat", type text}, {"fiscal_year", Int64.Type}, {"vendor_count", Int64.Type}, {"vendor_spend", type number}, {"top_vendor_share", type number}, {"hhi", type number}}, "en-US")
				in
				    Typed

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

