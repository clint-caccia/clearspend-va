// ClearSpend VA measures. These are already in clearspend_va.pbip; this file is a readable copy,
// and you can paste them with "New measure" if you build the model yourself.

// ---- Calculated table (Modeling > New table) ----
// Shared year list so one slicer filters both fact tables.
FiscalYears =
DISTINCT (
    UNION (
        VALUES ( fact_monthly[fiscal_year] ),
        VALUES ( fact_vendor_year[fiscal_year] )
    )
)

// ---- Measures ----
Total Spend =
SUM ( fact_monthly[amount] )

Refunds =
SUM ( fact_monthly[refund_amount] )

Transactions =
SUM ( fact_monthly[txn_count] )

Months Reported =
DISTINCTCOUNT ( fact_monthly[month] )

// Same months of the prior year, so an 11-month year isn't compared to a 12-month one.
Prior Year Spend =
VAR fy = SELECTEDVALUE ( FiscalYears[fiscal_year] )
VAR months = VALUES ( fact_monthly[fiscal_month] )
RETURN
    CALCULATE (
        [Total Spend],
        FiscalYears[fiscal_year] = fy - 1,
        TREATAS ( months, fact_monthly[fiscal_month] )
    )

YoY Change =
IF ( NOT ISBLANK ( [Prior Year Spend] ), [Total Spend] - [Prior Year Spend] )

YoY % =
DIVIDE ( [YoY Change], [Prior Year Spend] )

Share of Selected =
DIVIDE ( [Total Spend], CALCULATE ( [Total Spend], ALLSELECTED ( dim_agency ) ) )

Vendor Spend =
SUM ( fact_vendor_year[amount] )

Organization Vendor Spend =
CALCULATE ( [Vendor Spend], dim_vendor[vendor_type] = "Organization" )

Withheld Individual Spend =
CALCULATE ( [Vendor Spend], dim_vendor[vendor_type] = "Individual (withheld)" )

Agencies Paying =
CALCULATE ( DISTINCTCOUNT ( fact_vendor_year[agency_id] ), dim_vendor[vendor_type] = "Organization" )

Unreported Vendor Detail =
CALCULATE ( [Vendor Spend], dim_vendor[vendor_type] = "Not reported" )

// ---- On the vendor_concentration table (v_vendor_concentration.csv) ----
// Only agencies with 10+ vendors, which skips pass-through accounts.
Vendors =
IF ( MAX ( vendor_concentration[vendor_count] ) >= 10, MAX ( vendor_concentration[vendor_count] ) )

Paid to Vendors =
IF ( [Vendors] > 0, SUM ( vendor_concentration[vendor_spend] ) )

Top Vendor Share =
IF ( [Vendors] > 0, MAX ( vendor_concentration[top_vendor_share] ) )

HHI Score =
IF ( [Vendors] > 0, MAX ( vendor_concentration[hhi] ) )
